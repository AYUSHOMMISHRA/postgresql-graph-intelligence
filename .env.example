POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/graph_rag

# Created by `postgres-graph-rag-demo setup`; use this restricted DSN for
# tenant ingestion, retrieval, and MCP runtime calls.
PGR_RUNTIME_URL=postgresql://pgr_demo_runtime:pgr_demo_runtime_pw@localhost:5432/graph_rag
PGR_RUNTIME_ROLE=pgr_demo_runtime
PGR_RUNTIME_PASSWORD=pgr_demo_runtime_pw
PGR_DEMO_TENANT_ID=11111111-1111-1111-1111-111111111111
PGR_DEMO_NAMESPACE=incident-demo

# Set one provider key before running an end-to-end example.
OPENAI_API_KEY=
# GOOGLE_API_KEY=

# LiteLLM Gateway (all five are required for --provider litellm).
# Use the gateway root accepted by OpenAI clients; do not append an endpoint
# such as /chat/completions or /embeddings.
# LITELLM_API_KEY=
# LITELLM_BASE_URL=http://127.0.0.1:4000/v1
# LITELLM_CHAT_MODEL=gpt-5.6-luna
# LITELLM_EMBEDDING_MODEL=text-embedding-3-small
# LITELLM_EMBEDDING_DIMENSION=1536
